# Production HTTP headers (Netlify / Cloudflare Pages format).
# These are the real headers; index.html ships meta-tag equivalents for
# hosts that don't read this file. HSTS / COOP / COEP / X-Frame-Options
# / Permissions-Policy only function as real headers — keep them here.

/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), magnetometer=(), accelerometer=(), gyroscope=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Cross-Origin-Embedder-Policy: credentialless
  X-DNS-Prefetch-Control: on
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.gpteng.co; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://api.elections.kalshi.com https://demo-api.kalshi.co https://api.coinbase.com https://api.exchange.coinbase.com https://corsproxy.io https://api.codetabs.com https://api.allorigins.win; worker-src 'self' blob:; manifest-src 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests

# Long-cache hashed assets
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Service worker must never be cached — required for updates to propagate.
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
  Service-Worker-Allowed: /

/manifest.webmanifest
  Cache-Control: no-cache

# security.txt should be discoverable and uncached aggressively
/.well-known/security.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600
